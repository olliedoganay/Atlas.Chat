OLLAMA_URL=http://127.0.0.1:11434

# Leave blank to use the selected model's own temperature behavior.
CHAT_TEMPERATURE=

EMBED_MODEL=nomic-embed-text:latest
QDRANT_PATH=.data/qdrant
MEM0_COLLECTION=atlas_local_memory
EMBED_DIM=768
LANGGRAPH_CHECKPOINT_DB=.data/langgraph/checkpoints.sqlite
MEM0_HISTORY_DB=.data/mem0_history.sqlite
MEMORY_TOP_K=5

# Optional runtime tuning.
ATLAS_COMPACTION_TIMEOUT_SECONDS=25
ATLAS_RUNNER_TIMEOUT_SECONDS=120
ATLAS_RUNNER_GUI_TIMEOUT_SECONDS=900
# Use bridge only when snippets need package downloads or exposed preview ports.
ATLAS_RUNNER_NETWORK=none
